{
  "identifier": "default",
  "description": "Default capabilities for Spotlight Windows",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:webview:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:app:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default"
  ]
}
